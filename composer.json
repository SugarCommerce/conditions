{
  "name": "sugarcommerce/conditions",
  "description": "Rules a shop owner builds in the WordPress admin -- \"logged-in customers in the UK, on a weekend\" -- and one call that says whether they match.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/conditions",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    },
    {
      "name": "Lee Anthony",
      "homepage": "https://blockifywp.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/network": "dev-main",
    "sugarcommerce/plugin": "dev-main"
  },
  "suggest": {
    "ext-intl": "Country names in the site's language for the country pickers, when no countries provider is given."
  },
  "repositories": [
    {
      "type": "path",
      "url": "../network",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Conditions\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/conditions/issues",
    "source": "https://github.com/sugarcommerce/conditions"
  },
  "keywords": [
    "wordpress",
    "conditions",
    "rules",
    "conditional-logic",
    "rules-engine",
    "fraud",
    "admin-ui",
    "rest-api"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Conditions\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
